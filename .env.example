# Copy to .env and adjust.  Used by docker-compose.yml.

# Where the staged binary lives; must match DIST_DIR used by
# docker/prepare-dist.sh.
DIST_DIR=dist

# Image name and tag produced by `docker compose build`.
DOCKER_IMAGE_NAME=dnsguard-dev
DOCKER_IMAGE_TAG=local

# OCI labels baked into the image.  Optional.
# BUILD_DATE=1970-01-01T00:00:00Z
# VERSION=v0.0.0
# VCS_REF=unknown

# Persistent data.  Absolute paths work too, e.g. /my/own/workdir.
WORK_DIR=./docker/data/work
CONF_DIR=./docker/data/conf
