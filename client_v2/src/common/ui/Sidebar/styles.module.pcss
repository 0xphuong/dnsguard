.sidebarWrapper {
    display: block;
    min-width: 240px;

    @media (min-width: 1200px) {
        align-self: stretch;
        background-color: var(--sidebar-background);
    }
}

.sidebarContainer {
    display: none;
    flex-shrink: 0;

    @media (min-width: 1200px) {
        display: flex;
        flex-direction: column;
        position: sticky;
        top: 0;
        width: 100%;
        max-width: 240px;
        height: 100vh;
        padding: 16px 0;
        overflow-y: auto;
        z-index: 1;
        background-color: var(--sidebar-background);
    }

    &::-webkit-scrollbar {
        display: none;
    }
}

.sidebar {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 0;
}

/* The shield is artwork; the word beside it is live text, so it takes the
 * sidebar's own ink and stays legible whatever the theme does. */
.logo {
    display: inline-flex;
    align-items: center;
    gap: 8px;
}

.logoMark {
    width: 24px;
    height: 24px;
    flex: none;
    display: block;
}

.logoText {
    font-size: 18px;
    font-weight: var(--weight-bold);
    letter-spacing: -0.4px;
    line-height: 24px;
    white-space: nowrap;
}

/* The full lock-up, for light grounds only — see Logo.tsx for the numbers. */
.logoFull {
    height: 56px;
    width: auto;
    display: block;
}

.linkWrapper {
    display: flex;
    padding: 12px 16px 32px;
}

.link {
    text-decoration: none;
}

.logoCompany {
    color: var(--sidebar-logo);
}

.logoProduct {
    color: var(--sidebar-logo-muted);
}
