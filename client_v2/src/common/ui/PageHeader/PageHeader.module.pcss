.header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-bottom: var(--space-4);
    margin-bottom: var(--space-5);
    border-bottom: 1px solid var(--default-item-divider);
}

.text {
    min-width: 0;
}

.title {
    margin: 0;
    letter-spacing: -0.01em;
}

.subtitle {
    margin: 2px 0 0;
    color: var(--default-description-text);
}

.actions {
    flex: none;
    display: flex;
    align-items: center;
    gap: var(--space-3);
}
