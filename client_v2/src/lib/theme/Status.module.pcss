.statusRed {
    color: var(--default-error-link);
}

/* Was --default-link, which is the brand colour, so this rendered the same as
 * .statusBlue below and the two statuses were indistinguishable. */
.statusGreen {
    color: var(--default-success-text);
}

.statusYellow {
    color: var(--default-attention-link);
}

.statusBlue {
    color: var(--default-product-icon);
}
