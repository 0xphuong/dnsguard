.buttonGroup {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-4);

    @media (min-width: 768px) {
        flex-direction: row;
        align-items: center;
    }

    .button {
        min-width: 200px;
        max-width: 100%;

        @media (min-width: 768px) {
            width: auto;
        }
    }
}

.input {
    padding: var(--space-2) 0;
}

.checkbox {
    display: flex;
    align-items: center;
    padding: var(--space-2) 0;
}

.group {
    position: relative;
    padding: 0 var(--space-4);
}

.inner {
    padding-left: var(--space-6);
}

.error {
    margin-top: var(--space-2);
    font-size: var(--fs-text-t3);
    color: var(--default-error-link);
}

.actionRow {
    padding: var(--space-2) var(--space-4);

    .actionButton {
        width: auto;
        min-width: 200px;
    }
}

.action {
    /* Was 24px square.  WCAG 2.5.8 puts the floor at 24x24 for a pointer
     * target, which this met by exactly nothing; 28px leaves room to miss. */
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 0;
    outline: 0;
    padding: 0;
    cursor: pointer;
    background: none;
    transition: background-color var(--t2);
    color: var(--default-gray-icons);
    border-radius: var(--radius-sm);

    &:disabled {
        cursor: default;
        color: var(--disabled-secondary-button-stroke);
    }

    &:hover,
    &:focus {
        background-color: var(--hovered-page-background);
    }

    &:active {
        background-color: var(--pressed-page-background);
    }

    &_danger {
        color: var(--default-error-link);
    }

    /* Declared last: postcss-nested emits declarations that follow a nested
     * rule after it, so keeping the nested blocks together at the end is the
     * only order that reads the way it cascades. */
    &:focus-visible {
        box-shadow: var(--focus-ring);
    }
}
