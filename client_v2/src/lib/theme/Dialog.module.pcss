.body {
    padding: var(--space-2) var(--space-5);
    line-height: 1.5;
    color: var(--default-main-text);
    overflow-wrap: break-word;
    word-break: break-word;

    b {
        font-weight: var(--weight-bold);
    }
}

.description {
    padding: var(--space-2) var(--space-5);
    color: var(--default-description-text);
}

.footer {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-5) var(--space-5);

    @media (min-width: 768px) {
        flex-wrap: nowrap;
        justify-content: flex-end;
    }

    &_inner {
        padding: 0;
    }

    .button {
        width: auto;
        /* Was min-width: 200px.  Two of those exceed the 344px dialog and
         * force the footer to wrap, so the primary action ends up stacked
         * under the cancel.  Let flex size them and keep a thumb-sized
         * floor. */
        min-width: 112px;
        font-size: var(--fs-text-t2);
        font-weight: var(--weight-medium);
        flex: 1;

        @media (min-width: 768px) {
            flex: 0 0 auto;
        }
    }
}

.buttonContent {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
}

.buttonLoader {
    width: 20px;
    height: 20px;
    /* Spins inside a filled button, so it has to follow the button's label
     * rather than assume white. */
    color: var(--default-primary-button-text);
}

/* Was a bare colour with no affordance: nothing changed under the pointer, so
 * the only hint it was a control came from the cursor. */
.close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: var(--radius-sm);
    color: var(--default-gray-icons);
    transition:
        background-color var(--t2),
        color var(--t2);

    &:hover {
        background-color: var(--hovered-page-background);
        color: var(--default-main-text);
    }
}
