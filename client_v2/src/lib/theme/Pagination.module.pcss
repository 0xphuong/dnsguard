.wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-5) 0;

    @media (min-width: 768px) {
        flex-direction: row;
        justify-content: space-between;
        padding: var(--space-4) 0;
    }

    & .dropdownShowOnPage {
        width: 100%;
        height: 48px;
        display: inline-flex;
        align-items: center;
        justify-content: space-between;
        padding: var(--space-1) var(--space-3);
        border: 1px solid var(--default-item-divider);
        border-radius: var(--radius-md);
        background-color: var(--default-input-background);

        @media (min-width: 768px) {
            width: fit-content;
            height: 32px;
            margin-left: auto;
        }
    }
}

.pagesContainer {
    display: flex;
    align-items: center;
    gap: var(--space-1);
}

.limitContainer {
    width: 100%;

    @media (min-width: 768px) {
        width: auto;
        margin-left: auto;
    }
}

.arrow {
    &_active {
        cursor: default;
    }
}

.arrow,
.bullets {
    color: var(--default-gray-icons);

    &_left {
        transform: rotate(180deg);
    }
}

.button {
    /* Was 27x24, which cleared WCAG 2.5.8's 24px floor by three pixels in one
     * axis and none in the other. */
    min-width: 32px;
    height: 32px;
    padding: 0 var(--space-1);
    color: var(--default-main-text);
    background: none;
    border: 0;
    outline: 0;
    font-size: var(--fs-text-t2);
    /* Page numbers are the one place tabular figures stop the row from
     * shifting as the digit count grows. */
    font-variant-numeric: tabular-nums;
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition:
        background-color var(--t2),
        color var(--t2);

    /* Hover used to paint the button solid green — the same treatment as the
     * current page, so hovering made it look like you had already moved.
     * Hover raises the surface; only the current page is green. */
    &:hover {
        background-color: var(--hovered-page-background);
        color: var(--default-main-text);
    }

    &:disabled {
        cursor: default;

        .arrow {
            cursor: default;
        }

        &:hover,
        &:focus {
            background-color: transparent;
        }
    }

    &_active {
        background-color: var(--default-main-button);
        color: var(--default-primary-button-text);
        cursor: default;

        &:hover,
        &:focus {
            background-color: var(--default-main-button);
            color: var(--default-primary-button-text);
        }

        &:disabled {
            background-color: var(--disabled-main-button);

            &:hover,
            &:focus {
                background-color: var(--disabled-main-button);
            }
        }
    }
}

.dropdown {
    width: 100%;
    justify-content: space-between;

    /* Was @media (--s-viewport).  No postcss-custom-media is configured, so
     * the browser could not parse the condition and dropped the whole block —
     * this never applied.  768px is the breakpoint its siblings use. */
    @media (min-width: 768px) {
        width: auto;
        justify-content: flex-start;
    }
}

.summary {
    margin: 0 var(--space-2);
    line-height: var(--lh-t2-normal);
    font-variant-numeric: tabular-nums;
    color: var(--default-description-text);
}
