.placeholderWrapper {
    overflow: hidden;
    display: flex;
    justify-content: center;
    align-items: center;
}

.placeholderValue {
    margin-left: 2px;
    grid-area: 1 / 1 / 2 / 3;
    position: relative;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;

    &.searchValue {
        position: absolute;
        color: var(--default-description-text);
        left: 45px;
    }
}

.groupBadgeStyles,
.overflowCounter {
    color: var(--default-main-text);
    margin-left: var(--space-2);
    font-size: var(--fs-text-t3);
}

.overflowCounter {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    border-radius: var(--radius-sm);
    font-variant-numeric: tabular-nums;

    &.mobile {
        border-radius: 20px;

        @media (min-width: 1024px) {
            border-radius: var(--radius-sm);
            margin: 0 auto 0;
        }
    }
}

.option {
    position: relative;
    padding: var(--space-3) var(--space-4);
    /* transition: all animates layout properties too, so a hover could shift
     * the row.  Only the paint needs to move. */
    transition: background-color var(--t2);
    font-size: var(--fs-text-t2);
    color: var(--default-main-text);
    cursor: pointer;

    &:hover,
    &:focus {
        background-color: var(--hovered-dropdown-menu-background);
    }

    &_selected {
        background-color: var(--pressed-dropdown-menu-background);
        color: var(--default-main-text);

        /* A background one step darker is easy to miss when scanning a long
         * menu; the accent bar says which row is current at a glance. */
        &::before {
            content: '';
            position: absolute;
            inset: 0 auto 0 0;
            width: 2px;
            background-color: var(--default-main-button);
        }
    }

    &_disabled {
        color: var(--disabled-main-text);
        cursor: default;

        &:hover,
        &:focus {
            background-color: transparent;
        }
    }

    &_check,
    &_empty {
        display: flex;
        align-items: center;
        gap: var(--space-3);
        padding: var(--space-3) var(--space-4);
        font-size: var(--fs-text-t2);
    }

    &_empty {
        padding: var(--space-4);
        cursor: default;

        &:hover,
        &:focus {
            background-color: transparent;
        }
    }

    &_center {
        align-items: center;
    }

    .indicator {
        color: var(--default-product-icon);
    }

    .count {
        margin-left: auto;
        white-space: nowrap;
        color: var(--default-link);
    }

    .check {
        color: var(--default-gray-icons);

        &_active {
            color: var(--default-product-icon);
        }
    }

    .icon {
        color: var(--default-product-icon);
    }
}

.loader {
    color: var(--default-product-icon);
}

.loaderOverlay {
    margin-left: auto;
}

.dropdownIndicator {
    padding: 0 var(--space-3) 0 var(--space-2);
    cursor: pointer;
}

.dropdownIcon {
    color: var(--default-gray-icons);
    transition: transform var(--t2);

    &_hidden {
        display: none;
    }
}

.dropdownIconOpen {
    transform: rotate(180deg);
}

.clearIndicator {
    display: flex;
    align-items: center;
    cursor: pointer;
    border: none;
    background: none;
    padding: 0;
}

.clearIndicatorEnd {
    padding-right: var(--space-3);
}

.clearIcon {
    color: var(--default-gray-icons);
}

.menuLoaderOverlay {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-6);
    /* 280px of empty menu for one spinner; the menu jumped that far open and
     * then collapsed once the options arrived. */
    min-height: 160px;

    .menuLoader {
        width: 40px;
        height: 40px;
        color: var(--default-link);
    }
}

.dropdownOverlay {
    width: 100%;
    max-width: 100%;
    padding: 0;

    @media (min-width: 768px) {
        max-width: 344px;
    }
}

.dropdownTrigger {
    display: flex;
    align-items: center;
    height: 48px;
    padding: 0 var(--space-3) 0 var(--space-4);
    font-size: var(--fs-text-t2);
    color: var(--default-main-text);
    /* Reads as an input rather than a card: same inset surface the text
     * fields use, and the inactive stroke rather than the card divider. */
    background-color: var(--default-input-background);
    border: 1px solid var(--default-inactive-input-stroke);
    border-radius: var(--radius-md);
    overflow: hidden;
    cursor: pointer;
    transition:
        border-color var(--t2),
        background-color var(--t2);

    &:hover {
        border-color: var(--default-active-input-stroke);
    }

    .dropdownIcon {
        margin-left: auto;
    }

    @media (min-width: 1024px) {
        height: 36px;
    }

    &.disabled {
        cursor: default;
        border-color: var(--default-inactive-input-stroke);
    }
}

.dropdownValue {
    display: flex;
    align-items: center;
    width: 100%;
    max-width: calc(100% - 24px);
    padding-right: var(--space-2);
    gap: var(--space-2);
}

.dropdownText {
    margin-right: auto;
}

.label {
    word-break: break-word;
}

.empty {
    padding: var(--space-2);
    text-align: left;
    color: var(--default-description-text);
}
