/* The page is a stack of Sections, so all the card, label and footer styling
 * lives in that shared component now.  What is left is this page's own
 * measure and the one button override. */
.page.page {
    /* Wider than the shared 584px one-column cap, because these rows carry a
     * title, a description and a value; narrower than the full container, so
     * no control drifts away from the thing it controls. */
    @media (min-width: 1024px) {
        max-width: 760px;
    }
}

/* The stack supplies the spacing between sections, since Section itself no
 * longer sets a sibling margin — that broke the two-column DNS grid. */
.stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
}

/* A 200px outlined button gave this the weight of a primary action. */
.clearButton {
    width: auto;
    min-width: 0;
    align-self: flex-start;
}
