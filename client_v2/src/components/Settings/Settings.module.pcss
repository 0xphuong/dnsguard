/* One column, and every section in a card.
 *
 * The page used to be two widths at once: a 1080px container with the
 * filtering block capped at 640px inside it, which left about 456px empty
 * beside four switches.  Worse, controls landed on three different right
 * edges — 796, 912 and 1352 — so there was no single column to run an eye
 * down, which is the only way a settings page is ever read.
 *
 * A card per section also brings this page into the language the rest of the
 * app already speaks; it was the only screen whose content sat bare on the
 * page background.
 */
.page.page {
    /* Wider than the shared 584px one-column cap, because these rows carry a
     * title, a description and a value; narrower than the full container, so
     * no control drifts away from the thing it controls. */
    @media (min-width: 1024px) {
        max-width: 760px;
    }
}

.title {
    padding-bottom: 16px;
}

.card {
    border: 1px solid var(--default-item-divider);
    border-radius: var(--radius-lg);
    background-color: var(--default-cards-background);
    box-shadow: var(--elev-1);
    overflow: hidden;

    & + & {
        margin-top: var(--space-4);
    }
}

/* Identical in all three sections: the name on the left, and on the right the
 * one switch that turns the whole section off, where the section has one.
 * Two of these titles used to be a row's title carrying its own switch and
 * one was a bare heading above the rows, so the same thing looked like three
 * different things. */
.cardHeader {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    /* Matches the 16px SettingRow indents itself by, so the master switch
     * sits on the same edge as the switches it governs. */
    padding: var(--space-4) var(--space-4) var(--space-3);
    border-bottom: 1px solid var(--default-item-divider);
}

.cardHeading {
    min-width: 0;
}

.cardTitle {
    margin: 0;
}

.cardDesc {
    margin: 2px 0 0;
    color: var(--default-description-text);
}

/* Pulled in by exactly the width SettingRow reserves for its chevron slot
 * (20px) plus its gap (12px), so a section's master switch lands on the same
 * vertical line as every switch it governs. */
.cardSwitch {
    flex: none;
    margin-right: 32px;
}

/* No horizontal padding: SettingRow already carries 16px of its own, and
 * adding another 16 here indented every row past the card header, so the
 * header switch and the row switches landed on different edges. */
.cardBody {
    padding: var(--space-2) 0;
}

/* Destructive and irreversible, so it gets its own band on a recessed ground
 * at the foot of the card rather than being one more row in the same reading
 * flow as the toggles.  The confirm dialog was already in place. */
.cardFooter {
    display: flex;
    padding: var(--space-3) var(--space-4);
    border-top: 1px solid var(--default-item-divider);
    background-color: var(--default-page-background);
}

/* A 200px outlined button gave this the weight of a primary action. */
.clearButton {
    width: auto;
    min-width: 0;
    align-self: flex-start;
}
