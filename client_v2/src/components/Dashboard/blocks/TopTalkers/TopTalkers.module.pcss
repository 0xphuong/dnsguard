.card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    border: 1px solid var(--default-item-divider);
    border-radius: var(--radius-lg);
    background-color: var(--default-cards-background);
    box-shadow: var(--elev-1);
    overflow: hidden;
}

.header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--default-item-divider);
}

.title {
    margin: 0;
    color: var(--default-description-text);
    font-weight: var(--weight-semi-bold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
}

.subtitle {
    color: var(--default-description-text);
    white-space: nowrap;
}

.row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-4);
    border-bottom: 1px solid var(--default-item-divider);

    &:last-child {
        border-bottom: none;
    }

    &:hover {
        background-color: var(--hovered-page-background);
    }
}

.domain {
    min-width: 0;
    font-family: var(--font-family-monospace);
    color: var(--default-main-text);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.count {
    font-variant-numeric: tabular-nums;
    color: var(--default-main-text);
    white-space: nowrap;
}

/* Same reason as in the query stream: Button's 200px minimum is sized for a
 * form footer, and here it would leave the domain a single character wide. */
.blockButton {
    width: auto;
    min-width: 0;
}

.blockedLabel {
    color: var(--default-error-link);
    white-space: nowrap;
}

.empty {
    margin: 0;
    padding: var(--space-5) var(--space-4);
    color: var(--default-description-text);
    text-align: center;
}

/* The blocked state carries a label and its undo side by side, so the row
 * says what is true before it says what you can do about it. */
.stateCell {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    white-space: nowrap;
}

/* "Allowed because you wrote a rule" is not the same as "allowed because
 * nothing blocks it", and only the first one gets a label. */
.allowedLabel {
    color: var(--default-success-text);
    white-space: nowrap;
}
