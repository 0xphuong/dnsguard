.card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    border: 1px solid var(--default-item-divider);
    border-radius: var(--radius-lg);
    background-color: var(--default-cards-background);
    box-shadow: var(--elev-1);
    overflow: hidden;
}

.header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--default-item-divider);
}

.title {
    margin: 0;
    color: var(--default-description-text);
    font-weight: var(--weight-semi-bold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
}

.subtitle {
    color: var(--default-description-text);
    white-space: nowrap;
}

.row {
    display: grid;
    /* Fixed tracks, not auto.  Each row is its own grid, so an auto track
     * sizes to that row's content and a row carrying an undo pushed its
     * neighbours' columns out of line with every other row. */
    grid-template-columns: 8px minmax(0, 1fr) 44px 60px;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-4);
    border-bottom: 1px solid var(--default-item-divider);

    &:last-child {
        border-bottom: none;
    }

    &:hover {
        background-color: var(--hovered-page-background);
    }
}

.domain {
    min-width: 0;
    font-family: var(--font-family-monospace);
    color: var(--default-main-text);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.count {
    font-variant-numeric: tabular-nums;
    color: var(--default-main-text);
    white-space: nowrap;
}

.empty {
    margin: 0;
    padding: var(--space-5) var(--space-4);
    color: var(--default-description-text);
    text-align: center;
}

.dotCell {
    width: 8px;
    height: 8px;
}

.dot {
    border-radius: 50%;
}

.dotBlocked {
    background-color: var(--default-error-link);
}

.dotAllowed {
    background-color: var(--fills-success);
}

/* A quiet word, not a filled button.  Five outlined red buttons stacked in a
 * narrow rail shout louder than anything else on the page, and the same
 * mistake was already avoided in the query stream beside it.  The colour
 * arrives on hover, where it warns about the click being made. */
.action {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    /* The smallest target WCAG 2.5.8 accepts. */
    min-height: 24px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--default-description-text);
    cursor: pointer;
    white-space: nowrap;

    &:disabled {
        cursor: default;
        opacity: 0.5;
    }
}

.actionBlock:hover:not(:disabled) {
    color: var(--default-error-link);
    text-decoration: underline;
}

.actionUndo:hover:not(:disabled) {
    color: var(--default-link);
    text-decoration: underline;
}
