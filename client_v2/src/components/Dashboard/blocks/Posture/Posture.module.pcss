/* One bordered strip with internal dividers rather than a row of cards: the
 * segments are facets of a single answer, and nesting cards inside the page's
 * card grid would add a second frame around content that needs none. */
.posture {
    border: 1px solid var(--default-item-divider);
    border-radius: var(--radius-md);
    background-color: var(--default-cards-background);
    box-shadow: var(--elev-1);
    margin: 0 var(--space-4) var(--space-4);
    overflow: hidden;

    @media (min-width: 1024px) {
        margin: 0 0 var(--space-4);
    }
}

/* The grid is a child rather than the strip itself so that the note below can
 * sit outside it without every nth-child border rule having to account for a
 * full-width row. */
.segments {
    display: grid;
    grid-template-columns: 1fr 1fr;

    @media (min-width: 768px) {
        grid-template-columns: repeat(3, 1fr);
    }

    @media (min-width: 1024px) {
        /* Protection carries a control, so it gets the wider track. */
        grid-template-columns: 1.7fr repeat(5, 1fr);
    }
}

.segment {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    min-width: 0;
    padding: var(--space-3) var(--space-4);
    border-top: 1px solid var(--default-item-divider);
    border-left: 1px solid var(--default-item-divider);

    /* Suppress the outer edges so the dividers read as internal rules rather
     * than a double border against the strip's own outline. */
    &:nth-child(2n + 1) {
        border-left: none;
    }

    &:nth-child(-n + 2) {
        border-top: none;
    }

    @media (min-width: 768px) {
        &:nth-child(2n + 1) {
            border-left: 1px solid var(--default-item-divider);
        }

        &:nth-child(3n + 1) {
            border-left: none;
        }

        &:nth-child(-n + 3) {
            border-top: none;
        }
    }

    @media (min-width: 1024px) {
        border-top: none;

        &:nth-child(3n + 1) {
            border-left: 1px solid var(--default-item-divider);
        }

        &:first-child {
            border-left: none;
        }
    }
}

.segmentProtection {
    @media (min-width: 1024px) {
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-3);
    }
}

.segmentBody {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    min-width: 0;
}

.label {
    color: var(--default-description-text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.stateRow {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    min-width: 0;
}

.value {
    font-size: var(--fs-text-t2);
    line-height: var(--lh-t2-condenced);
    font-weight: var(--weight-medium);
    color: var(--default-main-text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* Ports, counts and latencies are machine values: tabular figures keep them
 * from shifting as they change, which they do on every refresh. */
.valueMono {
    font-variant-numeric: tabular-nums;
}

/* The one value the verdict is derived from, tinted only when the verdict is
 * "Attention", so the number and the dot agree. */
.valueWarn {
    color: var(--default-attention-link);
}

.valueMuted {
    color: var(--default-description-text);
    font-weight: var(--weight-regular);
}

.countdown {
    color: var(--default-description-text);
    font-variant-numeric: tabular-nums;
}

.dot {
    flex: none;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    /* Nudged off the baseline so it centres against the cap height. */
    transform: translateY(-1px);
}

/* The one glow in the interface, on the one fact that matters: a live filter.
 * Green rather than the brand azure, because this is a health state and not a
 * control — the switch beside it stays brand-coloured. */
.dotOn {
    background-color: var(--fills-success);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--fills-success) 22%, transparent);
}

.dotOff {
    background-color: var(--default-error-link);
}

.dotWarn {
    background-color: var(--default-attention-link);
}

.controls {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex: none;
}

.dropdownTrigger {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: none;
    background: none;
    cursor: pointer;
    color: var(--default-gray-icons);

    &:disabled {
        cursor: default;
        opacity: 0.4;
    }
}

.protectionMenu {
    padding: var(--space-1) 0;
}

/* Reads as a caption to the strip above, not a sixth fact: separated by the
 * same divider the segments use, and set in the description colour. */
.note {
    margin: 0;
    padding: var(--space-2) var(--space-4);
    border-top: 1px solid var(--default-item-divider);
    background-color: var(--default-page-background);
    color: var(--default-description-text);
}
