.card {
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-lg);
    padding: 8px 0 0;
    background-color: var(--default-cards-background);
    box-shadow: var(--elev-1);
    border: 1px solid var(--default-item-divider);
    overflow: hidden;

    @media (min-width: 768px) {
        /* Was a flat height: 374px, which held one row of upstreams in the same
         * box as ten rows of domains and left most of the grid empty.  A min
         * keeps the row heights even when two cards sit side by side; the max
         * caps a long list so the page does not turn into one tall column. */
        min-height: 232px;
        max-height: 420px;
        padding: 8px 8px 0;
    }
}

.cardBlocked {
    & .cardSubtitle {
        color: var(--default-error-link);
    }

    & .queryCount {
        color: var(--default-error-link);
    }

    & .queryBarFill {
        background: var(--default-error-link);
    }
}

.cardHeader {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-5) var(--space-4);

    @media (min-width: 768px) {
        padding: var(--space-4) var(--space-4) var(--space-3);
    }
}

.cardSubtitle {
    white-space: nowrap;
    color: var(--default-description-text);
}

.tableRow {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    min-height: 40px;
    gap: 0 24px;
    padding: 16px 24px 24px;
    transition: background-color var(--t2);
    border-bottom: 1px solid var(--default-item-divider);

    &:hover,
    &:focus {
        background-color: var(--hovered-page-background);
    }

    @media (min-width: 768px) {
        border-radius: 8px;
        padding: 8px 16px;
        border: none;
    }

    &:last-child {
        border: none;
    }

    & > .queryBar {
        display: block;
        width: 100%;

        @media (min-width: 768px) {
            display: none;
        }
    }
}

.tableRowLeft {
    display: flex;
    align-items: center;
    gap: 8px;
    flex: 1;
    min-width: 0;
}

.tableRowRight {
    display: flex;
    align-items: center;
    gap: 16px;
}

.tableRowIcon {
    width: 24px;
    height: 24px;
    stroke: var(--default-gray-icons);
    color: var(--default-gray-icons);
}

.tableRows {
    height: 100%;

    @media (min-width: 768px) {
        overflow-y: auto;
    }
}

.domainIcon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
}

/* Domains and upstream URLs are machine identifiers, and telling
 * google-analytics.com from goog1e-analytics.com is the whole job here.  A
 * proportional face hides exactly the differences that matter — rn against m,
 * l against 1 — so identifiers get the monospace stack.  Mono sets wider, so
 * these truncate a little sooner; every one of them now carries a title with
 * the full value. */
.domainName {
    color: var(--default-main-text);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-family: var(--font-family-monospace);
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.01em;
}

.queryCount {
    display: flex;
    align-items: center;
    gap: 4px;
    white-space: nowrap;
    flex-shrink: 0;
    font-variant-numeric: tabular-nums;
}

.dropdownWrapper {
    flex-shrink: 0;
}

.queryPercent {
    color: var(--default-description-text);
}

.queryBar {
    display: none;
    width: 100%;
    min-width: 102px;
    height: 3px;
    background: var(--default-item-divider);
    border-radius: 2px;

    @media (min-width: 768px) {
        display: block;
    }
}

.queryBarFill {
    height: 100%;
    background: var(--default-tertiary-stat);
}

.queryTooltip {
    font-size: var(--fs-text-t3);
    line-height: var(--lh-t3-normal);
    padding: 8px 12px;
    white-space: nowrap;
}

.queryTooltipOverlay {
    pointer-events: none;
}

.statRowValue {
    display: flex;
    align-items: center;
    gap: 16px;

    & .queryBar {
        min-width: 141px;
    }
}

.tableRowDot {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;

    &:before {
        content: '';
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background-color: var(--default-gray-icons);
    }
}
