.statsCards {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
    padding: 0 var(--space-4);
    margin-bottom: var(--space-6);

    @media (min-width: 1024px) {
        grid-template-columns: repeat(4, 1fr);
        gap: var(--space-4);
        padding: 0;
    }
}

.statCard {
    display: flex;
    flex-direction: column;
}

/* Each theme tints only the delta and the label, so the surface stays neutral
 * and the four tiles read as one row rather than four coloured panels. */
.statCardAds {
    & .statCardPercent {
        color: var(--default-error-link);
    }
}

.statCardThreats {
    & .statCardPercent {
        color: var(--default-attention-link);
    }
}

.statCardAdult {
    & .statCardPercent {
        color: var(--default-additional-link);
    }
}

.statCardInner {
    display: flex;
    flex-direction: column;
    height: 100%;
    border-radius: var(--radius-md);
    border: 1px solid var(--default-item-divider);
    background-color: var(--default-cards-background);
    transition: border-color var(--t2);

    &:hover {
        border-color: var(--default-active-input-stroke);
    }
}

/* Label first, then the number: the label is what the eye needs to bind the
 * value to, and it used to sit outside the border where it belonged to nothing. */
.statCardHeader {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-3) 0;

    @media (min-width: 768px) {
        padding: var(--space-4) var(--space-4) 0;
    }
}

.statCardLabel {
    min-width: 0;
    color: var(--default-description-text);
}

.statLabelLink {
    color: inherit;
    text-decoration: none;

    &:hover,
    &:focus {
        color: inherit;
        text-decoration: underline;
    }
}

.statCardPercent {
    flex: none;
    font-variant-numeric: tabular-nums;
    font-weight: var(--weight-medium);
}

.statCardValue {
    padding: var(--space-1) var(--space-3) 0;
    font-size: 24px;
    line-height: var(--lh-h4-normal);
    color: var(--default-main-text);
    font-weight: var(--weight-semi-bold);
    /* Counts change on every refresh; without tabular figures the number
     * reflows and the four tiles stop lining up. */
    font-variant-numeric: tabular-nums;

    @media (min-width: 768px) {
        padding: var(--space-1) var(--space-4) 0;
        font-size: var(--fs-title-h3);
        line-height: var(--lh-h3-normal);
    }
}

.statCardChart {
    min-height: 16px;
    height: 56px;
    margin-top: auto;
    padding: 0 var(--space-2);
    overflow: hidden;

    @media (min-width: 768px) {
        padding: 0 var(--space-3);
    }

    canvas {
        width: 100% !important;
        height: 100% !important;
        display: block;
    }
}

.chartTooltip {
    position: fixed;
    pointer-events: none;
    z-index: 100;
    opacity: 0;
    background: var(--default-cards-background);
    border: 1px solid var(--default-item-divider);
    border-radius: var(--radius-md);
    padding: var(--space-2) var(--space-3);
    box-shadow: 0 2px 8px var(--main-box-shadow);
}

.chartTooltipValue {
    font-size: var(--fs-text-t3);
    font-weight: var(--weight-semi-bold);
    color: var(--default-main-text);
    font-variant-numeric: tabular-nums;
}

.chartTooltipDate {
    font-size: var(--fs-text-t4);
    color: var(--default-description-text);
    margin-top: 2px;
}
