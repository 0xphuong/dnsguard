.statContainer {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
    padding: 0 var(--space-4);
    /* Cards in a row share the tallest one's height rather than stretching to
     * the row, so a short card stops inheriting a long neighbour's dead space. */
    align-items: start;

    @media (min-width: 1024px) {
        grid-template-columns: 1fr 1fr;
        gap: var(--space-4);
        padding: 0;
    }
}

.loader {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 200px;
}

.emptyState {
    flex: 1;
}
